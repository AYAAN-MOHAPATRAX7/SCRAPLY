# HarvestGuard & Gemma 4 Configuration
# Copy this file to .env and fill in your actual Gemma API key before starting.

# Gemma API Credentials
GEMMA_API_KEY=your_gemma_api_key_here

# Gemma Model Selection (e.g. gemma-4, gemma-2-9b-it, gemini-2.5-flash)
GEMMA_MODEL=gemma-4

# Server Configuration
HARVESTGUARD_ENV=development
HARVESTGUARD_PORT=8000
